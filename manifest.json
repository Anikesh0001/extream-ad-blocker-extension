{
  "manifest_version": 3,
  "name": "AdSweep — ad & tracker blocker",
  "version": "1.3.0",
  "description": "Powerful, private, open ad & tracker blocker. Blocks ads, trackers, cookie banners, popups, YouTube & anti-adblock walls. Element picker, zapper, network logger, custom lists, tracking-param stripping. 100% local.",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "tabs",
    "contextMenus",
    "alarms",
    "webNavigation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AdSweep",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "pick": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Block an element (picker)"
    },
    "zap": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Zap an element once"
    },
    "unwall": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Clear anti-adblock wall"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "src/content.js"
      ]
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "js": [
        "src/youtube.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/cosmetic/generic.css",
        "src/picker.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": false,
        "path": "rules/ads.json"
      },
      {
        "id": "privacy",
        "enabled": false,
        "path": "rules/privacy.json"
      },
      {
        "id": "adguard",
        "enabled": false,
        "path": "rules/adguard.json"
      },
      {
        "id": "cookies",
        "enabled": true,
        "path": "rules/cookies.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "rules/annoyances.json"
      },
      {
        "id": "social",
        "enabled": false,
        "path": "rules/social.json"
      },
      {
        "id": "badware",
        "enabled": true,
        "path": "rules/badware.json"
      },
      {
        "id": "privacyubo",
        "enabled": true,
        "path": "rules/privacyubo.json"
      },
      {
        "id": "resource",
        "enabled": true,
        "path": "rules/resource.json"
      },
      {
        "id": "anticv",
        "enabled": true,
        "path": "rules/anticv.json"
      },
      {
        "id": "quickfixes",
        "enabled": true,
        "path": "rules/quickfixes.json"
      },
      {
        "id": "unbreak",
        "enabled": true,
        "path": "rules/unbreak.json"
      }
    ]
  }
}